# Скопируйте этот файл в .env и укажите свои ключи. Файл .env в репозиторий не добавляется.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
OPENROUTER_API_KEY=
# необязательно: модель-оценщик LLM-as-a-Judge (DeepSeek API)
DEEPSEEK_API_KEY=
# необязательно: адрес API GigaChat; по умолчанию https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_BASE_URL=
